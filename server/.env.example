# SERVER ONLY. This file is documentation, not automatically loaded.
# Supply through process environment / secret manager; never VITE_ variables.
# No usable credentials or keys are committed.
DOCUMENT_MASTER_KEY_BASE64=
# JSON array of {tokenHash: SHA-256 of a random 32-byte base64url bearer token,
# id: random UUIDv4, role: officer|supervisor|admin, expiresAt: epoch milliseconds}.
# Expiry must be in the next 15 minutes. Never put the bearer token itself here.
DOCUMENT_DEV_SESSIONS=[]
# JSON object mapping server-generated UUIDv4 case IDs to assigned UUIDv4 user IDs.
# Do not use passport numbers, names or MRZ as identifiers.
DOCUMENT_DEV_ASSIGNMENTS={}
